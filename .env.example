# PactRoom Monorepo Environment Configuration

# PactRoom Server
PACTROOM_SERVER_PORT=4000
PACTROOM_SERVER_HOST=0.0.0.0
PACTROOM_DATABASE_URL="file:./pactroom.db"
NODE_ENV=development

# Workspaces
BACKEND_API_PORT=3001
BACKEND_API_URL=http://localhost:3001
FRONTEND_CONSUMER_URL=http://localhost:5173

# Optional: Point to your own external repositories (defaults to bundled demo workspaces)
# BACKEND_WORKSPACE=/Users/username/my-company/backend-api
# FRONTEND_WORKSPACE=/Users/username/my-company/frontend-consumer

# PactRoom Web (Next.js)
PORT=3000
NEXT_PUBLIC_PACTROOM_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001

# Switch Room Configuration
SWITCH_ROOM_ID="room-pactroom-prod-01"
SWITCH_ROOM_NAME="PactRoom Cross-Machine Negotiator"
SWITCH_API_KEY="switch_sk_live_pactroom_dev_preview"
SWITCH_PLATFORM="switch"

