# ==============================================================================
# PactRoom Monorepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PactRoom Core Server (Protocol Bridge & Engine)
# ------------------------------------------------------------------------------
PACTROOM_SERVER_PORT=3002
PACTROOM_SERVER_HOST=0.0.0.0
PACTROOM_DATABASE_PATH=./pactroom.db
NODE_ENV=development

# ------------------------------------------------------------------------------
# Microservice Workspaces (Machine A Backend & Machine B Frontend)
# ------------------------------------------------------------------------------
BACKEND_API_PORT=3001
BACKEND_API_URL=http://localhost:3001
FRONTEND_CONSUMER_URL=http://localhost:5173

# Optional: Point to your own external repositories (defaults to bundled demo workspaces)
# BACKEND_WORKSPACE=/Users/username/my-company/backend-api
# FRONTEND_WORKSPACE=/Users/username/my-company/frontend-consumer

# Filesystem Watcher (Machine A Backend)
ENABLE_FS_WATCHER=true

# ------------------------------------------------------------------------------
# PactRoom Web Studio & Landing Page (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_PACTROOM_SERVER_URL=http://localhost:3002
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
NEXT_PUBLIC_MATTERMOST_URL=http://localhost:60015

# ------------------------------------------------------------------------------
# Switch Protocol & Room Configuration
# ------------------------------------------------------------------------------
SWITCH_ROOM_ID="room-pactroom-prod-01"
SWITCH_ROOM_NAME="PactRoom Cross-Machine Negotiator"
SWITCH_API_KEY="switch_sk_live_pactroom_dev_preview"
SWITCH_PLATFORM="switch"
SWITCH_TEAM_SLUG="pactroom"

# ------------------------------------------------------------------------------
# Switch Console / Mattermost Collaborative Room Bridge
# ------------------------------------------------------------------------------
# Switch Console downloaded app uses dynamic ports (typically 60015 or 49388).
# PactRoom auto-discovers port 60015, 49388, and 8065 automatically.
SWITCH_MATTERMOST_URL=http://localhost:60015
SWITCH_MATTERMOST_TOKEN=gtrp6bar1bfgpgt51g6cywybnr
SWITCH_CHANNEL_ID=tpdxwefawpggtyu5uyxqo3iz5o
SWITCH_TEAM_NAME=switch
SWITCH_CHANNEL_NAME=pactroom-api-contracts

# Direct Bot Persona Tokens (generated by Switch template)
SWITCH_WATCH_TOKEN=uuztj6g7ajdtim6zra1z3bb8zc
SWITCH_VERIFY_TOKEN=qso9qytdu7by9m46wjugocsqny
